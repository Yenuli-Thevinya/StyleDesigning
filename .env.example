# ==============================================================================
# StyleSync Environment Configuration
# Copy this file to .env to customize local Docker Compose settings.
# ==============================================================================

# Database Settings
POSTGRES_DB=stylesync_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433

# Service Ports Exposed on Host
BACKEND_PORT=5000
FRONTEND_PORT=5173
AI_SERVICE_PORT=8000

# Backend Environment
ASPNETCORE_ENVIRONMENT=Development

# AI Service Settings
LLM_API_KEY=
USE_MEMORY_CHECKPOINTER=false
